# .env.example
# DO NOT COMMIT ACTUAL SECRETS HERE. This file documents the required environment variables.

# Firebase Configuration (Already securely managed via firebase-applet-config.json and injected)

# Stripe Payment Integration
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLIC_KEY=

# Twilio SMS Automation
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# EmailJS (For client-side email)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Admin Email Notification Settings
ADMIN_NOTIFY_EMAIL=alsharqmobile@gmail.com
RESEND_API_KEY=

